{
  "$schema": "https://opencode.ai/config.json",
  "//": "E6 context-exposure config, condition 'argscope'. Generated by scenarios/e6_configs.py.",
  "model": "ollama/qwen2.5:14b-24k",
  "small_model": "ollama/qwen2.5:14b-24k",
  "tools": {
    "bash": false,
    "read": false,
    "write": false,
    "edit": false,
    "glob": false,
    "grep": false,
    "list": false,
    "patch": false,
    "webfetch": false,
    "todowrite": false,
    "todoread": false,
    "task": false
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:14b-24k": {
          "name": "Qwen2.5 14B (24k ctx)",
          "tool_call": true,
          "limit": {
            "context": 24576,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "nmap": {
      "enabled": false
    },
    "filesystem-lab": {
      "type": "local",
      "enabled": true,
      "command": [
        "python",
        "F:/project0/MCP-Project/proxy/logging_proxy.py",
        "--log-dir",
        "F:/project0/MCP-Project/logs/raw",
        "--server-id",
        "filesystem",
        "--label",
        "opencode",
        "--",
        "python",
        "F:/project0/MCP-Project/servers/fs_server.py",
        "--root",
        "F:/project0/MCP-Project/lab"
      ]
    },
    "memory-lab": {
      "type": "local",
      "enabled": true,
      "command": [
        "python",
        "F:/project0/MCP-Project/proxy/logging_proxy.py",
        "--log-dir",
        "F:/project0/MCP-Project/logs/raw",
        "--server-id",
        "memory",
        "--label",
        "opencode",
        "--",
        "python",
        "F:/project0/MCP-Project/servers/memory_server.py",
        "--enforce-boundary"
      ]
    }
  }
}
