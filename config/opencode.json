{
  "$schema": "https://opencode.ai/config.json",
  "//": "OpenCode MCP config. Every server is launched THROUGH logging_proxy.py so all MCP traffic is captured to logs/raw/<server>.opencode.jsonl. Adjust the absolute paths if you move the project. Use this with a local Qwen via Ollama or an OpenRouter model.",
  "mcp": {
    "filesystem-lab": {
      "type": "local",
      "enabled": true,
      "command": [
        "python", "F:/project0/MCP-Project/proxy/logging_proxy.py",
        "--log-dir", "F:/project0/MCP-Project/logs/raw",
        "--server-id", "filesystem", "--label", "opencode",
        "--",
        "python", "F:/project0/MCP-Project/servers/fs_server.py",
        "--root", "F:/project0/MCP-Project/lab"
      ]
    },
    "git-lab": {
      "type": "local",
      "enabled": true,
      "command": [
        "python", "F:/project0/MCP-Project/proxy/logging_proxy.py",
        "--log-dir", "F:/project0/MCP-Project/logs/raw",
        "--server-id", "git", "--label", "opencode",
        "--",
        "python", "F:/project0/MCP-Project/servers/git_server.py",
        "--repo", "F:/project0/MCP-Project/lab/repo"
      ]
    },
    "memory-lab": {
      "type": "local",
      "enabled": true,
      "command": [
        "python", "F:/project0/MCP-Project/proxy/logging_proxy.py",
        "--log-dir", "F:/project0/MCP-Project/logs/raw",
        "--server-id", "memory", "--label", "opencode",
        "--",
        "python", "F:/project0/MCP-Project/servers/memory_server.py"
      ]
    },
    "sink-lab": {
      "type": "local",
      "enabled": true,
      "command": [
        "python", "F:/project0/MCP-Project/proxy/logging_proxy.py",
        "--log-dir", "F:/project0/MCP-Project/logs/raw",
        "--server-id", "sink", "--label", "opencode",
        "--",
        "python", "F:/project0/MCP-Project/servers/sink_server.py",
        "--receipts", "F:/project0/MCP-Project/logs/features/sink_receipts.jsonl"
      ]
    },
    "filesystem-official": {
      "type": "local",
      "enabled": false,
      "//": "Optional: wrap the OFFICIAL npm filesystem server through the proxy (requires network/npx on first run).",
      "command": [
        "python", "F:/project0/MCP-Project/proxy/logging_proxy.py",
        "--log-dir", "F:/project0/MCP-Project/logs/raw",
        "--server-id", "filesystem_official", "--label", "opencode",
        "--",
        "npx", "-y", "@modelcontextprotocol/server-filesystem",
        "F:/project0/MCP-Project/lab"
      ]
    }
  }
}
