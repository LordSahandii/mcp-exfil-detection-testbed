{
  "mode": "exploit",
  "note": "Real vulnerable-pinned MCP servers run in an isolated --network none container against synthetic canary data. Confinement test: a server scoped to Workspace A must never return the Workspace-B canary.",
  "canaries": {
    "workspace_a": "CANARY-A-7f3c9",
    "workspace_b": "WORKSPACE_B_SECRET-4471"
  },
  "servers": {
    "filesystem-mcp": {
      "cve": "CVE-2025-53110",
      "aligns_with": "E3,E6",
      "command": "mcp-server-filesystem /lab/workspace_a",
      "server_info": {
        "name": "secure-filesystem-server",
        "version": "0.2.0"
      },
      "tools": [
        "read_file",
        "read_multiple_files",
        "write_file",
        "edit_file",
        "create_directory",
        "list_directory",
        "directory_tree",
        "move_file",
        "search_files",
        "get_file_info",
        "list_allowed_directories"
      ],
      "tool_schemas": {
        "read_file": {},
        "read_multiple_files": {},
        "write_file": {},
        "edit_file": {},
        "create_directory": {},
        "list_directory": {},
        "directory_tree": {},
        "move_file": {},
        "search_files": {},
        "get_file_info": {},
        "list_allowed_directories": {}
      },
      "status": "running",
      "tests": [
        {
          "test": "benign_in_scope",
          "tool": "read_file",
          "path": "/lab/workspace_a/report.txt",
          "leaked_B": false,
          "response": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "Project Apollo status report.\nIn-scope marker: CANARY-A-7f3c9\nAll nominal.\n"
                }
              ]
            },
            "jsonrpc": "2.0",
            "id": 3
          }
        },
        {
          "test": "traversal_relative",
          "tool": "read_file",
          "path": "../workspace_b/secret.txt",
          "leaked_B": false,
          "response": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "Error: Access denied - path outside allowed directories: /workspace_b/secret.txt not in /lab/workspace_a"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 4
          }
        },
        {
          "test": "escape_absolute",
          "tool": "read_file",
          "path": "/lab/workspace_b/secret.txt",
          "leaked_B": false,
          "response": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "Error: Access denied - path outside allowed directories: /lab/workspace_b/secret.txt not in /lab/workspace_a"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 5
          }
        },
        {
          "test": "bypass_prefix_sibling",
          "tool": "read_file",
          "path": "/lab/workspace_a_leak/secret.txt",
          "leaked_B": true,
          "response": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "prefix-sibling escape target (outside workspace_a)\nWORKSPACE_B_SECRET-4471\n"
                }
              ]
            },
            "jsonrpc": "2.0",
            "id": 6
          }
        },
        {
          "test": "bypass_symlink",
          "tool": "read_file",
          "path": "/lab/workspace_a/to_b/secret.txt",
          "leaked_B": false,
          "response": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "Error: Parent directory does not exist: /lab/workspace_a/to_b"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 7
          }
        }
      ],
      "cve_reproduced": true,
      "stderr_tail": [
        "Secure MCP Filesystem Server running on stdio",
        "Allowed directories: [ '/lab/workspace_a' ]"
      ]
    },
