{
  "tool": {
    "name": "mcp-audit",
    "publisher": "APIsec",
    "version": "1.1.0"
  },
  "what_it_is": "Static scanner: reads MCP config files and server source before deployment. It does not run servers or capture traffic. The CVE servers below were only scanned, not run.",
  "lab_configs": {
    "benign": {
      "scanned_file": "config/e3/benign/mcp.json",
      "servers": {
        "filesystem-lab": {
          "risk_flags": [
            "filesystem-access"
          ],
          "registry_provider": "Anthropic",
          "registry_risk": "high",
          "registry_verified": true
        },
        "poisoned-lab": {
          "risk_flags": [],
          "registry_provider": null,
          "registry_risk": null,
          "registry_verified": false
        },
        "sink-lab": {
          "risk_flags": [],
          "registry_provider": null,
          "registry_risk": null,
          "registry_verified": false
        }
      },
      "findings": [
        {
          "flag": "filesystem-access",
          "severity": "high",
          "affected": [
            "filesystem-lab"
          ]
        }
      ]
    },
    "startup": {
      "scanned_file": "config/e3/startup/mcp.json",
      "servers": {
        "filesystem-lab": {
