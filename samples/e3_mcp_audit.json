            "filesystem-lab"
          ]
        }
      ]
    },
    "rugpull": {
      "scanned_file": "config/e3/rugpull/mcp.json",
      "servers": {
        "filesystem-lab": {
          "risk_flags": [
            "filesystem-access"
          ],
          "registry_provider": "Anthropic",
          "registry_risk": "high",
          "registry_verified": true
        },
        "poisoned-lab": {
          "risk_flags": [],
          "registry_provider": null,
