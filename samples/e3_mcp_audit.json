  "cve_servers": {
    "git-mcp": {
      "aligns_with": [
        "E1",
        "E5",
        "E6"
      ],
      "cve": null,
      "note": "poisoned-repository scenario (no CVE)",
      "command": "uvx mcp-server-git --repository /repo",
      "risk_flags": [],
      "registry_provider": "Unknown",
      "registry_risk": "unknown",
      "registry_match_name": null
    },
    "filesystem-mcp": {
      "aligns_with": [
        "E3",
        "E6"
      ],
      "cve": "CVE-2025-53110",
      "note": "directory-containment bypass; fixed in 2025.7.1",
      "command": "npx -y @modelcontextprotocol/server-filesystem@2025.3.28 /data",
      "risk_flags": [
        "filesystem-access",
        "unverified-source"
      ],
      "registry_provider": "Model Context Protocol",
      "registry_risk": "high",
      "registry_match_name": "Filesystem"
    },
    "excel-mcp": {
      "aligns_with": [
        "E3",
        "E6"
      ],
      "cve": "CVE-2026-85661",
      "note": "path traversal in stdio mode when EXCEL_FILES_PATH unset; vulnerable 0.1.8",
      "command": "uvx excel-mcp-server@0.1.8 stdio",
      "risk_flags": [],
      "registry_provider": "Unknown",
      "registry_risk": "unknown",
      "registry_match_name": null
    },
    "memory-mcp": {
      "aligns_with": [
        "E1",
        "E6"
      ],
      "cve": null,
      "note": "poisoned-observations scenario (no CVE)",
      "command": "npx -y @modelcontextprotocol/server-memory",
      "risk_flags": [
        "unverified-source"
      ],
      "registry_provider": "Model Context Protocol",
      "registry_risk": "low",
      "registry_match_name": "Memory"
    },
    "kubernetes-mcp": {
      "aligns_with": [
        "E5",
        "E6"
      ],
      "cve": "CVE-2025-53355",
      "note": "command injection via execSync; fixed in 2.5.0",
      "command": "npx -y mcp-server-kubernetes@2.4.0",
      "risk_flags": [
        "unverified-source"
      ],
      "registry_provider": "Unknown",
      "registry_risk": "unknown",
      "registry_match_name": null
    },
    "whatsapp-mcp": {
      "aligns_with": [
        "E2",
        "E3",
        "E6"
      ],
      "cve": "CVE-2026-46555",
      "note": "unauthenticated bridge, path traversal in media_path; fixed in 0.2.1 (package name illustrative)",
      "command": "npx -y whatsapp-mcp-server@0.2.0",
      "risk_flags": [
        "unverified-source"
      ],
      "registry_provider": "Unknown",
      "registry_risk": "unknown",
      "registry_match_name": null
    },
    "playwright-mcp": {
      "aligns_with": [
        "E4",
        "E5",
        "E6"
      ],
      "cve": "CVE-2025-9611",
      "note": "DNS rebinding, missing Origin check; fixed in 0.0.40",
      "command": "npx -y @playwright/mcp@0.0.39 --port 8080",
      "risk_flags": [
        "unverified-source"
      ],
      "registry_provider": "Unknown",
      "registry_risk": "unknown",
      "registry_match_name": null
    }
  }
